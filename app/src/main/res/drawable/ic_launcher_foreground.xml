        android:pathData="M54,27 L77.38,40.5 L77.38,67.5 L54,81 L30.62,67.5 L30.62,40.5 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.5"
        android:strokeWidth="1.6"
