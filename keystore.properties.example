# Copie para keystore.properties (que fica fora do Git) e preencha para assinar o release.
# Para criar uma chave:
#   keytool -genkeypair -v -keystore hubweb-release.jks -alias hubweb -keyalg RSA -keysize 2048 -validity 10000
# Guarde o .jks e as senhas em lugar seguro: sem a mesma chave, os aparelhos não aceitam atualizar o app.
storeFile=hubweb-release.jks
storePassword=troque-esta-senha
keyAlias=hubweb
keyPassword=troque-esta-senha
