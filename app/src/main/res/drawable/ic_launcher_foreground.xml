    <path android:pathData="M54,64 L54,76" android:strokeColor="#FFFFFFFF" android:strokeWidth="2.6" android:strokeLineCap="round" />
    <path android:pathData="M45.34,59 L34.95,65" android:strokeColor="#FFFFFFFF" android:strokeWidth="2.6" android:strokeLineCap="round" />
    <path android:pathData="M45.34,49 L34.95,43" android:strokeColor="#FFFFFFFF" android:strokeWidth="2.6" android:strokeLineCap="round" />

    <!-- nós (o do topo é o destaque âmbar) -->
    <path android:fillColor="#FFFFCA28" android:pathData="M49,27 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M72.38,40.5 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M72.38,67.5 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
