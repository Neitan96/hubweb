{
  "manifest_version": 3,
  "name": "HubWeb",
  "version": "1.0",
  "description": "Detecção do usuário logado nos sistemas abertos no Gecko (HubWeb).",
  "browser_specific_settings": {
    "gecko": { "id": "hubweb@hubweb.com.br" }
  },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
